# Public domain of the mini app. localhost works for a local run (self-signed certificate).
DOMAIN=localhost
POSTGRES_DB=join_db
POSTGRES_USER=join_user
POSTGRES_PASSWORD=change_me_strong_password
# MAX bot token (from https://business.max.ru → Чат-боты → Интеграция)
MAX_BOT_TOKEN=your_bot_token_here
# Public HTTPS base URL for the bot webhook (/api/max/webhook is appended)
MAX_WEBHOOK_URL=
# Optional: shared secret MAX sends in X-Max-Bot-Api-Secret (5-256 chars, A-Za-z0-9_-)
MAX_WEBHOOK_SECRET=
ADMIN_PORT=8081
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Telegram bot (optional — the Telegram mini app is disabled while empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OpenAI-compatible API for chat icebreakers
AI_API_KEY=
AI_BASE_URL=https://api.aiproductiv.ru/v1
AI_MODEL=gpt-6-luna

# JWT signing secret — Base64-encoded, must decode to >= 32 bytes.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_DAYS=30
